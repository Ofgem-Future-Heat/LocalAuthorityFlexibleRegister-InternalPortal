@page
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_InternalPortal.Extensions
@model DeclarationDetailEditCompletedModel

@{
    ViewData["Title"] = "Declaration Edit Confirmation - LA Flex - Ofgem";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="govuk-panel govuk-panel--confirmation  govuk-!-margin-bottom-5">
            <h1 class="govuk-panel__title">
                Change complete
            </h1>
        </div>

        <h2 class="govuk-heading-l">What happens next</h2>

        <p class="govuk-body">
            You have successfully fixed the error(s) identified on the declaration notification. A new superseded declaration notification has been created and will reflect the changes.
        </p>

        <p class="govuk-body">
            Please note that your declaration will now undergo Statement of Intent checks and any errors found can be viewed on the declaration details page.
        </p>

        <p class="govuk-body">
            You can always access previous versions of the declaration notification in the superseded declarations at the bottom of the declaration details page.
        </p>

    </div>
</div>


<div class="govuk-button-group govuk-!-static-margin-top-9">
    
    @if (Model.HasDeclarationId)
    {
        <a asp-page="@LafPages.DeclarationDetail.ROUTE"
           asp-page-handler="@LafPages.DeclarationDetail.METHOD_GET_WITH_ID_ACTION"
           asp-route-declarationId="@Model.DeclarationId"
           data-test-id="ShowDeclarationButton"
           class="govuk-button">Declaration details</a>
    }

    <a asp-page="@LafPages.Dashboard.ROUTE"
       data-test-id="ShowDashboardButton"
       class="govuk-button govuk-button--secondary">Dashboard</a>

</div>

