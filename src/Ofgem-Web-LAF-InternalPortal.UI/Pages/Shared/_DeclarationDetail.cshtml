@model Ofgem_Web_LAF_InternalPortal.Pages.Declarations.DeclarationDetailModel

@if (Model.Declaration != null)
{
    @await Html.PartialAsync("_DeclarationDetailAddress", (Model.Declaration.AddressLine1, Model.Declaration.AddressLine2, Model.Declaration.PostCode, Model.DeclarationErrorFields))

    @await Html.PartialAsync("_DeclarationDetailReferral", (Model.Declaration, Model.DeclarationErrorFields, true))

    @await Html.PartialAsync("_DeclarationDetailAssessment", Model.Declaration)
}