<div id="js-timeout-warning-backdrop" class="js-timeout-warning-backdrop">
    <dialog class="govuk-timeout-warning dialog" id="js-timeout-warning" aria-live="polite" aria-labelledby="dialog-title" open="">
        <h1 data-test-id="GovukSignOutHeadingText" id="dialog-title" class="govuk-heading-l">
            You will be signed out soon
        </h1>
        <div data-test-id="SignOutSelectionMessage" class="govuk-body">
            <p>For your security, you will be signed out in <strong>5 minutes</strong>.</p>
        </div>
        <button class="govuk-button dialog-button js-dialog-close"
                data-module="govuk-button"
                onclick="document.getElementById('js-timeout-warning-backdrop').style.visibility = 'hidden';"
                data-test-id="GovukContinue">
            Continue
        </button>
    </dialog>
</div>