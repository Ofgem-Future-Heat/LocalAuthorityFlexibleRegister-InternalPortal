@using Ofgem_Web_LAF_InternalPortal.Extensions
@using Ofgem_Web_LAF_InternalPortal.Models

@model Ofgem_Web_LAF_InternalPortal.Models.PagePagination


@if (Model != null)
{
    <!-- Pagination -->
    <nav class="govuk-pagination govuk-!-display-block" role="navigation" aria-label="results">

        @if (Model.NoDataFound)
        {
            <div class="govuk-pagination__prev">@Model.Message</div>
        }
        else
        {
            @if (Model.ShowPrevious)
            {
                <div class="govuk-pagination__prev">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                    </svg>
                    <input class="govuk-link pagination previous" type="submit" value="@PagePagination.PREVIOUS" asp-page-handler="@LafPages.METHOD_APPLY_PAGINATION" asp-route-id="@PagePagination.PREVIOUS_PAGE_VALUE" />
                </div>
            }

            @if (Model.PageNumbers != null && Model.PageNumbers.Count > 1)
            {
                <ul class="govuk-pagination__list">
                    @foreach (var pageNumber in Model.PageNumbers)
                    {
                        @if (pageNumber == "...")
                        {
                            <li class="govuk-pagination__item govuk-pagination__item">...</li>
                        }
                        else
                        {
                            <li class="govuk-pagination__item govuk-pagination__item @(Model.CurrentPage == pageNumber ? "current" : "")">
                                <input class="pagination @(Model.CurrentPage == pageNumber ? "current" : "")"
                                       type="submit"
                                       value="@pageNumber"
                                       aria-label="@(Model.CurrentPage == pageNumber ? "Current" : "") Page @pageNumber"
                                       asp-page-handler="@LafPages.METHOD_APPLY_PAGINATION"
                                       asp-route-id="@pageNumber" />
                            </li>
                        }
                    }
                </ul>
            }

            @if (Model.ShowNext)
            {
                <div class="govuk-pagination__next">
                    <input class="govuk-link pagination next" type="submit" value="@PagePagination.NEXT" asp-page-handler="@LafPages.METHOD_APPLY_PAGINATION" asp-route-id="@PagePagination.NEXT_PAGE_VALUE" />
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                    </svg>
                </div>
            }
        }

        <input type="hidden" id="CurrentPage" name="CurrentPage" value="@(Model.CurrentPage)" />

    </nav>
}